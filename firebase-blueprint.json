{
  "entities": {
    "Message": {
      "title": "Contact Message",
      "description": "Message submitted by a visitor via the professional communication gateway.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique key identifier." },
        "name": { "type": "string", "description": "Sender full name." },
        "email": { "type": "string", "format": "email", "description": "Sender verified email address." },
        "subject": { "type": "string", "description": "Subject of the inquiry." },
        "message": { "type": "string", "description": "Text body of the message." },
        "timestamp": { "type": "string", "format": "date-time", "description": "ISO timestamp of creation." },
        "sessionId": { "type": "string", "description": "Client session tracking identification." },
        "deviceInfo": { "type": "string", "description": "User agent browser information." },
        "locationData": { "type": "string", "description": "Bhopal MP / Guest relative coordinates or region." },
        "referralSource": { "type": "string", "description": "Route source of portfolio landing." },
        "status": { "type": "string", "enum": ["unread", "read", "archived", "replied"], "description": "Reading and lifecycle action state." }
      },
      "required": ["name", "email", "subject", "message", "timestamp", "status"]
    },
    "Conversation": {
      "title": "AI Mentor Conversation",
      "description": "Interaction logging of AI Shinobi Mentor learning roadmaps and suggestions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique interaction identifier." },
        "sessionId": { "type": "string", "description": "Session linking token." },
        "chakraType": { "type": "string", "description": "Operational shinobi element selected." },
        "experience": { "type": "string", "description": "Current rank level of visitor." },
        "interest": { "type": "string", "description": "Targeted sector interest." },
        "userMessage": { "type": "string", "description": "Query details or user goals." },
        "aiResponse": { "type": "string", "description": "Markdown recommendations generated by Gemini." },
        "timestamp": { "type": "string", "format": "date-time", "description": "ISO timestamp of model response." }
      },
      "required": ["sessionId", "chakraType", "experience", "interest", "aiResponse", "timestamp"]
    }
  },
  "firestore": {
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Incoming inquiries from the communication gateway."
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Conversations stored with the AI Shinobi Mentor."
    }
  }
}
